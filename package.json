{
  "name": "cam-toys",
  "productName": "cam-toys",
  "version": "0.2.0",
  "description": "Fun webcam filters + virtual camera",
  "main": "./out/main/index.js",
  "author": "AllMites",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "gallery": "vite --config src/engine/dev/vite.config.mjs --open /src/engine/dev/gallery.html",
    "models": "node scripts/fetch-models.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "smoke": "electron scripts/smoke/run.mjs",
    "screenshot": "electron scripts/screenshot.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AllMites/cam-toys.git"
  },
  "homepage": "https://github.com/AllMites/cam-toys#readme",
  "bugs": {
    "url": "https://github.com/AllMites/cam-toys/issues"
  }
}
